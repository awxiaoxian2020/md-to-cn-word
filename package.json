{
  "name": "md-to-cn-word",
  "version": "0.4.0",
  "description": "将Markdown转换为符合中国大陆地区惯用的初始风格的Word文档的库",
  "type": "module",
  "main": "./src/module.js",
  "exports": {
    ".": "./src/module.js"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test.js",
    "build": "mkdir -p dist && cp -r src/* dist/"
  },
  "keywords": [
    "markdown",
    "docx",
    "converter",
    "chinese-style",
    "library"
  ],
  "author": "Xavi Lee",
  "homepage": "https://github.com/awxiaoxian2020/md-to-cn-word",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awxiaoxian2020/md-to-cn-word.git"
  },
  "bugs": {
    "url": "https://github.com/awxiaoxian2020/md-to-cn-word/issues"
  },
  "license": "LGPL-3.0-or-later",
  "packageManager": "pnpm@10.2.0+sha512.0d27364e0139c6aadeed65ada153135e0ca96c8da42123bd50047f961339dc7a758fc2e944b428f52be570d1bd3372455c1c65fa2e7aa0bfbf931190f9552001",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "html-to-docx": "^1.8.0",
    "inline-css": "^4.0.3",
    "showdown": "^2.1.0"
  }
}
